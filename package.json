{
  "name": "sift",
  "displayName": "Sift",
  "description": "Plan a large change set into reviewed, atomic commits, and ask the AI of your choice about any line.",
  "publisher": "msalmi",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sift",
          "title": "Sift",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sift": [
        {
          "id": "sift.plan",
          "name": "Plan"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sift.plan",
        "contents": "No review session in this repository.\n[$(sparkle) Plan commits with AI](command:sift.planWithAi)\nThe AI groups your uncommitted changes into commits and explains them.\n[Start review](command:sift.start)\nOr start without AI and create commits by hand.\nAI: [choose which AI to use](command:sift.chooseAi)",
        "when": "!sift.active"
      },
      {
        "view": "sift.plan",
        "contents": "Every file is approved, and approved files are hidden.\n[$(eye) Show approved files](command:sift.showDone)",
        "when": "sift.active && sift.hideDone"
      }
    ],
    "commands": [
      {
        "command": "sift.start",
        "title": "Start review",
        "category": "Sift"
      },
      {
        "command": "sift.refresh",
        "title": "Refresh",
        "category": "Sift",
        "icon": "$(refresh)"
      },
      {
        "command": "sift.loadPlan",
        "title": "Load plan from .sift/plan.json",
        "category": "Sift",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sift.planWithAi",
        "title": "Plan commits with AI",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.chooseAi",
        "title": "Choose AI…",
        "category": "Sift",
        "icon": "$(hubot)"
      },
      {
        "command": "sift.newCommit",
        "title": "New commit",
        "category": "Sift",
        "icon": "$(add)"
      },
      {
        "command": "sift.renameCommit",
        "title": "Edit commit message",
        "category": "Sift"
      },
      {
        "command": "sift.deleteCommit",
        "title": "Delete commit (files become unassigned)",
        "category": "Sift"
      },
      {
        "command": "sift.moveCommitUp",
        "title": "Move commit up",
        "category": "Sift",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sift.moveCommitDown",
        "title": "Move commit down",
        "category": "Sift",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sift.startCommit",
        "title": "Review this commit",
        "category": "Sift"
      },
      {
        "command": "sift.openDiff",
        "title": "Open diff",
        "category": "Sift"
      },
      {
        "command": "sift.toggleDiffMode",
        "title": "Toggle diff mode (this round / cumulative)",
        "category": "Sift",
        "icon": "$(diff)"
      },
      {
        "command": "sift.compareVersions",
        "title": "A specific version…",
        "category": "Sift",
        "icon": "$(versions)"
      },
      {
        "command": "sift.revealFile",
        "title": "Show in Sift sidebar",
        "category": "Sift",
        "icon": "$(list-tree)"
      },
      {
        "command": "sift.markDone",
        "title": "Approve file",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.unapproveFile",
        "title": "Unapprove file",
        "category": "Sift",
        "icon": "$(close)"
      },
      {
        "command": "sift.markInProgress",
        "title": "Mark in progress",
        "category": "Sift"
      },
      {
        "command": "sift.markTodo",
        "title": "Mark to do",
        "category": "Sift"
      },
      {
        "command": "sift.ignoreFile",
        "title": "Add to .gitignore",
        "category": "Sift"
      },
      {
        "command": "sift.excludeFile",
        "title": "Exclude locally (.git/info/exclude)",
        "category": "Sift"
      },
      {
        "command": "sift.nextTodo",
        "title": "Next to do",
        "category": "Sift",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "sift.previousFile",
        "title": "Previous file in this commit",
        "category": "Sift",
        "icon": "$(arrow-left)"
      },
      {
        "command": "sift.nextFile",
        "title": "Next file in this commit",
        "category": "Sift",
        "icon": "$(arrow-right)"
      },
      {
        "command": "sift.moveToCommit",
        "title": "Move to commit…",
        "category": "Sift"
      },
      {
        "command": "sift.approveCommit",
        "title": "Approve and commit",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.abort",
        "title": "Start over…",
        "category": "Sift"
      },
      {
        "command": "sift.askAi",
        "title": "Ask AI about all open comments",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.toggleExplanations",
        "title": "Show / hide AI explanations",
        "category": "Sift",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sift.comment.create",
        "title": "Add (ask later)",
        "category": "Sift"
      },
      {
        "command": "sift.comment.reply",
        "title": "Add (ask later)",
        "category": "Sift"
      },
      {
        "command": "sift.comment.ask",
        "title": "Ask AI",
        "category": "Sift"
      },
      {
        "command": "sift.comment.askThread",
        "title": "Ask AI",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.comment.cancelAsk",
        "title": "Stop the AI",
        "category": "Sift",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sift.comment.edit",
        "title": "Edit",
        "category": "Sift",
        "icon": "$(edit)"
      },
      {
        "command": "sift.comment.deleteMessage",
        "title": "Delete comment",
        "category": "Sift",
        "icon": "$(trash)"
      },
      {
        "command": "sift.comment.saveEdit",
        "title": "Save",
        "category": "Sift"
      },
      {
        "command": "sift.comment.cancelEdit",
        "title": "Cancel",
        "category": "Sift"
      },
      {
        "command": "sift.comment.resolve",
        "title": "Resolve",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.comment.reopen",
        "title": "Reopen",
        "category": "Sift",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "sift.comment.delete",
        "title": "Delete thread",
        "category": "Sift",
        "icon": "$(trash)"
      },
      {
        "command": "sift.collapseAll",
        "title": "Collapse all",
        "category": "Sift",
        "icon": "$(collapse-all)"
      },
      {
        "command": "sift.expandAll",
        "title": "Expand all",
        "category": "Sift",
        "icon": "$(expand-all)"
      },
      {
        "command": "sift.viewAsTree",
        "title": "View as tree",
        "category": "Sift",
        "icon": "$(list-tree)"
      },
      {
        "command": "sift.viewAsList",
        "title": "View as list",
        "category": "Sift",
        "icon": "$(list-flat)"
      },
      {
        "command": "sift.unexclude",
        "title": "Remove from .git/info/exclude",
        "category": "Sift",
        "icon": "$(eye)"
      },
      {
        "command": "sift.hideDone",
        "title": "Hide approved files",
        "category": "Sift",
        "icon": "$(eye-closed)"
      },
      {
        "command": "sift.showDone",
        "title": "Show approved files",
        "category": "Sift",
        "icon": "$(eye)"
      },
      {
        "command": "sift.diffRound",
        "title": "Previous version (this round)",
        "category": "Sift"
      },
      {
        "command": "sift.diffRoundOn",
        "title": "✓ Previous version (this round)",
        "category": "Sift"
      },
      {
        "command": "sift.diffCumulative",
        "title": "Last commit (HEAD): the whole change",
        "category": "Sift"
      },
      {
        "command": "sift.diffCumulativeOn",
        "title": "✓ Last commit (HEAD): the whole change",
        "category": "Sift"
      },
      {
        "command": "sift.comment.copy",
        "title": "Copy message",
        "category": "Sift",
        "icon": "$(copy)"
      },
      {
        "command": "sift.useGithubAvatar",
        "title": "Use my GitHub picture in comments",
        "category": "Sift",
        "icon": "$(account)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sift.planWithAi",
          "when": "view == sift.plan",
          "group": "navigation@0"
        },
        {
          "command": "sift.loadPlan",
          "when": "view == sift.plan && sift.active",
          "group": "z@3"
        },
        {
          "command": "sift.newCommit",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@2"
        },
        {
          "command": "sift.approveCommit",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@4"
        },
        {
          "command": "sift.refresh",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@5"
        },
        {
          "command": "sift.abort",
          "when": "view == sift.plan && sift.active",
          "group": "z@1"
        },
        {
          "command": "sift.toggleExplanations",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@6"
        },
        {
          "command": "sift.chooseAi",
          "when": "view == sift.plan",
          "group": "z@0"
        },
        {
          "command": "sift.hideDone",
          "when": "view == sift.plan && sift.active && !sift.hideDone",
          "group": "navigation@7"
        },
        {
          "command": "sift.showDone",
          "when": "view == sift.plan && sift.active && sift.hideDone",
          "group": "navigation@7"
        },
        {
          "command": "sift.viewAsTree",
          "when": "view == sift.plan && sift.active && !sift.viewAsTree",
          "group": "navigation@8"
        },
        {
          "command": "sift.viewAsList",
          "when": "view == sift.plan && sift.active && sift.viewAsTree",
          "group": "navigation@8"
        },
        {
          "command": "sift.collapseAll",
          "when": "view == sift.plan && sift.active && !sift.treeCollapsed",
          "group": "navigation@9"
        },
        {
          "command": "sift.expandAll",
          "when": "view == sift.plan && sift.active && sift.treeCollapsed",
          "group": "navigation@9"
        },
        {
          "command": "sift.useGithubAvatar",
          "when": "view == sift.plan",
          "group": "z@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sift.approveCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "1@0"
        },
        {
          "command": "sift.startCommit",
          "when": "view == sift.plan && viewItem == commit",
          "group": "1@1"
        },
        {
          "command": "sift.renameCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "1@2"
        },
        {
          "command": "sift.moveCommitUp",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "2@1"
        },
        {
          "command": "sift.moveCommitDown",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "2@2"
        },
        {
          "command": "sift.deleteCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "3@1"
        },
        {
          "command": "sift.markDone",
          "when": "viewItem =~ /^file-(todo|in-progress)$/",
          "group": "1@1"
        },
        {
          "command": "sift.unapproveFile",
          "when": "viewItem == file-done",
          "group": "1@1"
        },
        {
          "command": "sift.markInProgress",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1@2"
        },
        {
          "command": "sift.markTodo",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1@3"
        },
        {
          "command": "sift.ignoreFile",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.excludeFile",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1_ignore@2"
        },
        {
          "command": "sift.unexclude",
          "when": "view == sift.plan && viewItem == excluded-entry",
          "group": "inline"
        },
        {
          "command": "sift.unexclude",
          "when": "view == sift.plan && viewItem == excluded-entry",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.moveToCommit",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "2@1"
        }
      ],
      "editor/title": [
        {
          "command": "sift.askAi",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "sift.previousFile",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "sift.nextFile",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "sift.markDone",
          "when": "sift.active && isInDiffEditor && !sift.activeFileApproved",
          "group": "navigation@3"
        },
        {
          "command": "sift.unapproveFile",
          "when": "sift.active && isInDiffEditor && sift.activeFileApproved",
          "group": "navigation@3"
        },
        {
          "command": "sift.nextTodo",
          "when": "sift.active && isInDiffEditor",
          "group": "sift@1"
        },
        {
          "command": "sift.toggleExplanations",
          "when": "sift.active && isInDiffEditor",
          "group": "sift@3"
        },
        {
          "submenu": "sift.compareWith",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "sift.unexclude",
          "when": "sift.active"
        },
        {
          "command": "sift.hideDone",
          "when": "sift.active && !sift.hideDone"
        },
        {
          "command": "sift.showDone",
          "when": "sift.active && sift.hideDone"
        },
        {
          "command": "sift.openDiff",
          "when": "false"
        },
        {
          "command": "sift.comment.create",
          "when": "false"
        },
        {
          "command": "sift.comment.reply",
          "when": "false"
        },
        {
          "command": "sift.comment.resolve",
          "when": "false"
        },
        {
          "command": "sift.comment.reopen",
          "when": "false"
        },
        {
          "command": "sift.comment.delete",
          "when": "false"
        },
        {
          "command": "sift.comment.edit",
          "when": "false"
        },
        {
          "command": "sift.comment.deleteMessage",
          "when": "false"
        },
        {
          "command": "sift.comment.saveEdit",
          "when": "false"
        },
        {
          "command": "sift.comment.cancelEdit",
          "when": "false"
        },
        {
          "command": "sift.comment.ask",
          "when": "false"
        },
        {
          "command": "sift.comment.askThread",
          "when": "false"
        },
        {
          "command": "sift.comment.cancelAsk",
          "when": "false"
        },
        {
          "command": "sift.diffRoundOn",
          "when": "false"
        },
        {
          "command": "sift.diffCumulativeOn",
          "when": "false"
        },
        {
          "command": "sift.comment.copy",
          "when": "false"
        },
        {
          "command": "sift.revealFile",
          "when": "sift.active"
        },
        {
          "command": "sift.ignoreFile",
          "when": "sift.active"
        },
        {
          "command": "sift.excludeFile",
          "when": "sift.active"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "sift.comment.ask",
          "group": "inline@1",
          "when": "commentController == sift"
        },
        {
          "command": "sift.comment.create",
          "group": "inline@2",
          "when": "commentController == sift && commentThreadIsEmpty"
        },
        {
          "command": "sift.comment.reply",
          "group": "inline@2",
          "when": "commentController == sift && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "sift.comment.askThread",
          "group": "inline@0",
          "when": "commentController == sift && commentThread == comment-open"
        },
        {
          "command": "sift.comment.cancelAsk",
          "group": "inline@0",
          "when": "commentController == sift && commentThread == comment-sent"
        },
        {
          "command": "sift.comment.resolve",
          "group": "inline@1",
          "when": "commentController == sift && commentThread =~ /-(open|answered)$/"
        },
        {
          "command": "sift.comment.reopen",
          "group": "inline@1",
          "when": "commentController == sift && commentThread =~ /-resolved$/"
        },
        {
          "command": "sift.comment.delete",
          "group": "inline@2",
          "when": "commentController == sift && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "sift.comment.copy",
          "group": "inline@0",
          "when": "commentController == sift && comment =~ /^(own|ai)$/"
        },
        {
          "command": "sift.comment.edit",
          "group": "inline@1",
          "when": "commentController == sift && comment == own"
        },
        {
          "command": "sift.comment.deleteMessage",
          "group": "inline@2",
          "when": "commentController == sift && comment == own"
        }
      ],
      "comments/comment/context": [
        {
          "command": "sift.comment.saveEdit",
          "group": "inline@1",
          "when": "commentController == sift"
        },
        {
          "command": "sift.comment.cancelEdit",
          "group": "inline@2",
          "when": "commentController == sift"
        }
      ],
      "sift.compareWith": [
        {
          "command": "sift.diffRound",
          "when": "sift.diffMode != round",
          "group": "1@1"
        },
        {
          "command": "sift.diffRoundOn",
          "when": "sift.diffMode == round",
          "group": "1@1"
        },
        {
          "command": "sift.diffCumulative",
          "when": "sift.diffMode != cumulative",
          "group": "1@2"
        },
        {
          "command": "sift.diffCumulativeOn",
          "when": "sift.diffMode == cumulative",
          "group": "1@2"
        },
        {
          "command": "sift.compareVersions",
          "group": "2@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "sift.tab",
          "when": "sift.active && resourceScheme =~ /^(file|sift)$/",
          "group": "sift@1"
        }
      ],
      "sift.tab": [
        {
          "command": "sift.revealFile",
          "group": "0@1"
        },
        {
          "command": "sift.markDone",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles",
          "group": "1@1"
        },
        {
          "command": "sift.unapproveFile",
          "when": "resourcePath in sift.doneFiles",
          "group": "1@1"
        },
        {
          "command": "sift.markInProgress",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1@2"
        },
        {
          "command": "sift.markTodo",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1@3"
        },
        {
          "command": "sift.ignoreFile",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.excludeFile",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1_ignore@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sift.markDone",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "sift.active"
      },
      {
        "command": "sift.markTodo",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "sift.active"
      },
      {
        "command": "sift.nextTodo",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "sift.active"
      },
      {
        "command": "sift.toggleDiffMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "sift.active"
      },
      {
        "command": "sift.askAi",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "sift.active && !commentEditorFocused"
      },
      {
        "command": "editor.action.submitComment",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused"
      },
      {
        "command": "workbench.view.extension.sift",
        "key": "ctrl+alt+s",
        "mac": "ctrl+shift+s"
      }
    ],
    "configuration": {
      "title": "Sift",
      "properties": {
        "sift.stateLocation": {
          "type": "string",
          "enum": [
            "repo",
            "workspaceStorage"
          ],
          "enumDescriptions": [
            "<repo>/.sift/state.json (excluded from git via .git/info/exclude)",
            "VS Code workspace storage (outside the repo)"
          ],
          "default": "repo",
          "description": "Where the review state file is stored."
        },
        "sift.snapshotMaxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "New (untracked) files larger than this are left out of snapshots."
        },
        "sift.ai.provider": {
          "type": "string",
          "enum": [
            "claude-code",
            "vscode-lm",
            "command"
          ],
          "enumDescriptions": [
            "Claude Code: the binary of the Claude Code VS Code extension, or `claude` from your shell. Uses your Claude login.",
            "A chat model registered in VS Code (GitHub Copilot, or any extension that provides models). See sift.ai.languageModel.",
            "Any command line tool that reads the prompt on stdin and prints the answer. See sift.ai.command."
          ],
          "default": "claude-code",
          "description": "Which AI Sift asks. Run \"Sift: Choose AI…\" to pick from what is available."
        },
        "sift.ai.claudeCodeModel": {
          "type": "string",
          "default": "",
          "description": "Model for Claude Code, e.g. opus, sonnet, haiku. Empty: Claude Code's default."
        },
        "sift.ai.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Path to the claude binary. Empty: the one bundled with the Claude Code extension, else `claude` from your shell."
        },
        "sift.ai.claudeCodeAdditionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders outside the repository Claude Code may read, e.g. `~/code` for sibling worktrees. Without them, reads outside the repository are denied."
        },
        "sift.ai.claudeCodeAllowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra tools Claude Code may use without asking, e.g. `WebFetch`, `mcp__claude_ai_Atlassian` (every tool of that MCP server) or `mcp__claude_ai_Atlassian__getJiraIssue`. Naming an MCP tool loads your MCP servers, which makes each call slower. A one-shot run cannot ask for permission, so tools that are not listed are denied."
        },
        "sift.ai.languageModel": {
          "type": "string",
          "default": "",
          "description": "Id of the VS Code language model (provider vscode-lm). Empty: the first available."
        },
        "sift.ai.command": {
          "type": "string",
          "default": "",
          "description": "Command for provider \"command\", run in your login shell at the repo root. It gets the prompt on stdin and must print a JSON answer, e.g. `codex exec -`."
        }
      }
    },
    "submenus": [
      {
        "id": "sift.compareWith",
        "label": "Compare with",
        "icon": "$(versions)"
      },
      {
        "id": "sift.tab",
        "label": "Sift"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build -- --production && vsce package --no-dependencies"
  },
