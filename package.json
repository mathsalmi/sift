{
  "name": "sift",
  "displayName": "Sift",
  "description": "Plan a large change set into reviewed, atomic commits, and ask the AI of your choice about any line.",
  "publisher": "msalmi",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sift",
          "title": "Sift",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sift": [
        {
          "id": "sift.plan",
          "name": "Plan"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sift.plan",
        "contents": "No review session in this repository.\n[$(sparkle) Plan commits with AI](command:sift.planWithAi)\nThe AI groups your uncommitted changes into commits and explains them.\n[Plan commits manually](command:sift.start)\nCreate commits yourself and drag files into them.",
        "when": "!sift.active"
      },
      {
        "view": "sift.plan",
        "contents": "Every file is approved, and approved files are hidden.\n[$(eye) Show approved files](command:sift.showDone)",
        "when": "sift.active && sift.hideDone"
      }
    ],
    "commands": [
      {
        "command": "sift.start",
        "title": "Plan commits manually",
        "category": "Sift"
      },
      {
        "command": "sift.refresh",
        "title": "Refresh",
        "category": "Sift",
        "icon": "$(refresh)"
      },
      {
        "command": "sift.planWithAi",
        "title": "Plan commits with AI",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.chooseAi",
        "title": "Choose AI…",
        "category": "Sift",
        "icon": "$(hubot)"
      },
      {
        "command": "sift.newCommit",
        "title": "New commit",
        "category": "Sift",
        "icon": "$(add)"
      },
      {
        "command": "sift.renameCommit",
        "title": "Edit commit message",
        "category": "Sift"
      },
      {
        "command": "sift.deleteCommit",
        "title": "Delete commit (files become unassigned)",
        "category": "Sift"
      },
      {
        "command": "sift.moveCommitUp",
        "title": "Move commit up",
        "category": "Sift",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sift.moveCommitDown",
        "title": "Move commit down",
        "category": "Sift",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sift.startCommit",
        "title": "Review this commit",
        "category": "Sift"
      },
      {
        "command": "sift.openDiff",
        "title": "Open diff",
        "category": "Sift"
      },
      {
        "command": "sift.toggleDiffMode",
        "title": "Toggle diff mode (this round / cumulative)",
        "category": "Sift",
        "icon": "$(diff)"
      },
      {
        "command": "sift.compareVersions",
        "title": "A specific version…",
        "category": "Sift",
        "icon": "$(versions)"
      },
      {
        "command": "sift.revealFile",
        "title": "Show in Sift sidebar",
        "category": "Sift",
        "icon": "$(list-tree)"
      },
      {
        "command": "sift.markDone",
        "title": "Approve file",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.unapproveFile",
        "title": "Unapprove file",
        "category": "Sift",
        "icon": "$(close)"
      },
      {
        "command": "sift.markInProgress",
        "title": "Mark in progress",
        "category": "Sift"
      },
      {
        "command": "sift.markTodo",
        "title": "Mark to do",
        "category": "Sift"
      },
      {
        "command": "sift.ignoreFile",
        "title": "Add to .gitignore",
        "category": "Sift"
      },
      {
        "command": "sift.excludeFile",
        "title": "Exclude locally (.git/info/exclude)",
        "category": "Sift"
      },
      {
        "command": "sift.nextTodo",
        "title": "Next to do",
        "category": "Sift",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "sift.previousFile",
        "title": "Previous file in this commit",
        "category": "Sift",
        "icon": "$(arrow-left)"
      },
      {
        "command": "sift.nextFile",
        "title": "Next file in this commit",
        "category": "Sift",
        "icon": "$(arrow-right)"
      },
      {
        "command": "sift.moveToCommit",
        "title": "Move to commit…",
        "category": "Sift"
      },
      {
        "command": "sift.approveCommit",
        "title": "Approve and commit",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.abort",
        "title": "Discard plan",
        "category": "Sift"
      },
      {
        "command": "sift.askAi",
        "title": "Ask AI about all open comments",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.toggleExplanations",
        "title": "Show / hide AI explanations",
        "category": "Sift",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sift.comment.create",
        "title": "Add (ask later)",
        "category": "Sift"
      },
      {
        "command": "sift.comment.reply",
        "title": "Add (ask later)",
        "category": "Sift"
      },
      {
        "command": "sift.comment.ask",
        "title": "Ask AI",
        "category": "Sift"
      },
      {
        "command": "sift.comment.askThread",
        "title": "Ask AI",
        "category": "Sift",
        "icon": "$(sparkle)"
      },
      {
        "command": "sift.comment.cancelAsk",
        "title": "Stop the AI",
        "category": "Sift",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sift.comment.edit",
        "title": "Edit",
        "category": "Sift",
        "icon": "$(edit)"
      },
      {
        "command": "sift.comment.deleteMessage",
        "title": "Delete comment",
        "category": "Sift",
        "icon": "$(trash)"
      },
      {
        "command": "sift.comment.saveEdit",
        "title": "Save",
        "category": "Sift"
      },
      {
        "command": "sift.comment.cancelEdit",
        "title": "Cancel",
        "category": "Sift"
      },
      {
        "command": "sift.comment.resolve",
        "title": "Resolve",
        "category": "Sift",
        "icon": "$(check)"
      },
      {
        "command": "sift.comment.reopen",
        "title": "Reopen",
        "category": "Sift",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "sift.comment.delete",
        "title": "Delete thread",
        "category": "Sift",
        "icon": "$(trash)"
      },
      {
        "command": "sift.collapseAll",
        "title": "Collapse all",
        "category": "Sift",
        "icon": "$(collapse-all)"
      },
      {
        "command": "sift.expandAll",
        "title": "Expand all",
        "category": "Sift",
        "icon": "$(expand-all)"
      },
      {
        "command": "sift.viewAsTree",
        "title": "View as tree",
        "category": "Sift",
        "icon": "$(list-tree)"
      },
      {
        "command": "sift.viewAsList",
        "title": "View as list",
        "category": "Sift",
        "icon": "$(list-flat)"
      },
      {
        "command": "sift.unexclude",
        "title": "Remove from .git/info/exclude",
        "category": "Sift",
        "icon": "$(eye)"
      },
      {
        "command": "sift.groupByStatus",
        "title": "Group files by status",
        "category": "Sift",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "sift.ungroupByStatus",
        "title": "Stop grouping files by status",
        "category": "Sift",
        "icon": "$(ungroup-by-ref-type)"
      },
      {
        "command": "sift.hideDone",
        "title": "Hide approved files",
        "category": "Sift",
        "icon": "$(eye-closed)"
      },
      {
        "command": "sift.showDone",
        "title": "Show approved files",
        "category": "Sift",
        "icon": "$(eye)"
      },
      {
        "command": "sift.diffRound",
        "title": "Previous version (this round)",
        "category": "Sift"
      },
      {
        "command": "sift.diffRoundOn",
        "title": "✓ Previous version (this round)",
        "category": "Sift"
      },
      {
        "command": "sift.diffCumulative",
        "title": "Last commit (HEAD): the whole change",
        "category": "Sift"
      },
      {
        "command": "sift.diffCumulativeOn",
        "title": "✓ Last commit (HEAD): the whole change",
        "category": "Sift"
      },
      {
        "command": "sift.comment.copy",
        "title": "Copy message",
        "category": "Sift",
        "icon": "$(copy)"
      }
    ],
    "languageModelTools": [
      {
        "name": "sift_getReview",
        "toolReferenceName": "siftReview",
        "displayName": "Sift: read the review",
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "userDescription": "The Sift review: planned commits, their files and status, and comments waiting for an answer.",
        "modelDescription": "Returns the Sift code review of this repository's uncommitted changes: the planned commits in order with their files and review status, unassigned files, and the developer's review comments that wait for an answer (with threadId, file, line and messages). Call it first, before planning commits or answering comments.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "sift_setPlan",
        "toolReferenceName": "siftPlan",
        "displayName": "Sift: set the commit plan",
        "canBeReferencedInPrompt": true,
        "icon": "$(git-commit)",
        "userDescription": "Split the uncommitted changes into a plan of atomic commits in Sift.",
        "modelDescription": "Sets the Sift commit plan: splits the repository's uncommitted changes into ordered, atomic commits (foundations first, each commit builds on its own), with an intent, risk notes and explanations on the lines that matter. Read the changes first (e.g. git diff). Replaces commits that are not committed yet. Sift never commits by itself: the developer reviews and approves each commit.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Imperative subject line (max 72 chars), optional body after a blank line."
                  },
                  "intent": {
                    "type": "string",
                    "description": "What this commit does and why, 1-2 sentences, for the reviewer."
                  },
                  "riskNotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Spots that deserve careful review."
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Repo-relative paths of changed files. Each changed file in exactly one commit; unlisted files stay unassigned."
                  },
                  "explanations": {
                    "type": "array",
                    "description": "Notes on the lines that carry intent or risk (not on mechanical changes).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "description": "One of this commit's files."
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "1-based line in the current file."
                        },
                        "body": {
                          "type": "string",
                          "description": "Markdown, max 3 short bullets: what changed here and why."
                        }
                      },
                      "required": [
                        "path",
                        "line",
                        "body"
                      ]
                    }
                  }
                },
                "required": [
                  "message",
                  "files"
                ]
              }
            }
          },
          "required": [
            "commits"
          ]
        }
      },
      {
        "name": "sift_explain",
        "toolReferenceName": "siftExplain",
        "displayName": "Sift: explain a line",
        "canBeReferencedInPrompt": true,
        "icon": "$(info)",
        "userDescription": "Add an explanation on a changed line in the Sift review.",
        "modelDescription": "Adds an explanation for the reviewer on a line of a changed file in the Sift review (shown in the diff editor). Use it for lines that carry intent or risk, not for mechanical changes. One explanation per line; a new one replaces the old.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Repo-relative path of a changed file."
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based line in the current file."
            },
            "body": {
              "type": "string",
              "description": "Markdown, max 3 short bullets."
            }
          },
          "required": [
            "path",
            "line",
            "body"
          ]
        }
      },
      {
        "name": "sift_reply",
        "toolReferenceName": "siftReply",
        "displayName": "Sift: answer a review comment",
        "canBeReferencedInPrompt": true,
        "icon": "$(comment-discussion)",
        "userDescription": "Answer a review comment in Sift, after making the change it asks for.",
        "modelDescription": "Answers one of the developer's review comments in Sift (threadId from sift_getReview). Make any code change the comment asks for first, with your own editing tools, then reply saying what you changed or why not. Sift records your changes as a new version so the developer sees exactly what changed. Set resolve only when nothing more is needed from the developer.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadId": {
              "type": "string"
            },
            "body": {
              "type": "string",
              "description": "Markdown reply, short and direct."
            },
            "resolve": {
              "type": "boolean",
              "description": "Close the thread."
            }
          },
          "required": [
            "threadId",
            "body"
          ]
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sift.planWithAi",
          "when": "view == sift.plan",
          "group": "navigation@0"
        },
        {
          "command": "sift.newCommit",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@2"
        },
        {
          "command": "sift.approveCommit",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@4"
        },
        {
          "command": "sift.refresh",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@5"
        },
        {
          "command": "sift.abort",
          "when": "view == sift.plan && sift.active",
          "group": "z@1"
        },
        {
          "command": "sift.toggleExplanations",
          "when": "view == sift.plan && sift.active",
          "group": "navigation@6"
        },
        {
          "command": "sift.groupByStatus",
          "when": "view == sift.plan && sift.active && !sift.groupByStatus",
          "group": "navigation@7"
        },
        {
          "command": "sift.ungroupByStatus",
          "when": "view == sift.plan && sift.active && sift.groupByStatus",
          "group": "navigation@7"
        },
        {
          "command": "sift.hideDone",
          "when": "view == sift.plan && sift.active && !sift.hideDone",
          "group": "navigation@7"
        },
        {
          "command": "sift.showDone",
          "when": "view == sift.plan && sift.active && sift.hideDone",
          "group": "navigation@7"
        },
        {
          "command": "sift.viewAsTree",
          "when": "view == sift.plan && sift.active && !sift.viewAsTree",
          "group": "navigation@8"
        },
        {
          "command": "sift.viewAsList",
          "when": "view == sift.plan && sift.active && sift.viewAsTree",
          "group": "navigation@8"
        },
        {
          "command": "sift.collapseAll",
          "when": "view == sift.plan && sift.active && !sift.treeCollapsed",
          "group": "navigation@9"
        },
        {
          "command": "sift.expandAll",
          "when": "view == sift.plan && sift.active && sift.treeCollapsed",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "sift.approveCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "1@0"
        },
        {
          "command": "sift.startCommit",
          "when": "view == sift.plan && viewItem == commit",
          "group": "1@1"
        },
        {
          "command": "sift.renameCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "1@2"
        },
        {
          "command": "sift.moveCommitUp",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "2@1"
        },
        {
          "command": "sift.moveCommitDown",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "2@2"
        },
        {
          "command": "sift.deleteCommit",
          "when": "view == sift.plan && viewItem =~ /^commit(-current)?$/",
          "group": "3@1"
        },
        {
          "command": "sift.markDone",
          "when": "viewItem =~ /^file-(todo|in-progress)$/",
          "group": "1@1"
        },
        {
          "command": "sift.unapproveFile",
          "when": "viewItem == file-done",
          "group": "1@1"
        },
        {
          "command": "sift.markInProgress",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1@2"
        },
        {
          "command": "sift.markTodo",
          "when": "viewItem =~ /^file-(todo|in-progress|done)$/",
          "group": "1@3"
        },
        {
          "command": "sift.ignoreFile",
          "when": "viewItem =~ /^file-(todo|in-progress|done|unassigned)$/",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.excludeFile",
          "when": "viewItem =~ /^file-(todo|in-progress|done|unassigned)$/",
          "group": "1_ignore@2"
        },
        {
          "command": "sift.unexclude",
          "when": "view == sift.plan && viewItem == excluded-entry",
          "group": "inline"
        },
        {
          "command": "sift.unexclude",
          "when": "view == sift.plan && viewItem == excluded-entry",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.moveToCommit",
          "when": "viewItem =~ /^file-(todo|in-progress|done|unassigned)$/",
          "group": "2@1"
        }
      ],
      "editor/title": [
        {
          "command": "sift.askAi",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "sift.previousFile",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "sift.nextFile",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@2"
        },
        {
          "command": "sift.markDone",
          "when": "sift.active && isInDiffEditor && sift.activeFileAssigned && !sift.activeFileApproved",
          "group": "navigation@3"
        },
        {
          "command": "sift.unapproveFile",
          "when": "sift.active && isInDiffEditor && sift.activeFileApproved",
          "group": "navigation@3"
        },
        {
          "command": "sift.nextTodo",
          "when": "sift.active && isInDiffEditor",
          "group": "sift@1"
        },
        {
          "command": "sift.toggleExplanations",
          "when": "sift.active && isInDiffEditor",
          "group": "sift@3"
        },
        {
          "submenu": "sift.compareWith",
          "when": "sift.active && isInDiffEditor",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "sift.groupByStatus",
          "when": "sift.active && !sift.groupByStatus"
        },
        {
          "command": "sift.ungroupByStatus",
          "when": "sift.active && sift.groupByStatus"
        },
        {
          "command": "sift.unexclude",
          "when": "sift.active"
        },
        {
          "command": "sift.hideDone",
          "when": "sift.active && !sift.hideDone"
        },
        {
          "command": "sift.showDone",
          "when": "sift.active && sift.hideDone"
        },
        {
          "command": "sift.openDiff",
          "when": "false"
        },
        {
          "command": "sift.comment.create",
          "when": "false"
        },
        {
          "command": "sift.comment.reply",
          "when": "false"
        },
        {
          "command": "sift.comment.resolve",
          "when": "false"
        },
        {
          "command": "sift.comment.reopen",
          "when": "false"
        },
        {
          "command": "sift.comment.delete",
          "when": "false"
        },
        {
          "command": "sift.comment.edit",
          "when": "false"
        },
        {
          "command": "sift.comment.deleteMessage",
          "when": "false"
        },
        {
          "command": "sift.comment.saveEdit",
          "when": "false"
        },
        {
          "command": "sift.comment.cancelEdit",
          "when": "false"
        },
        {
          "command": "sift.comment.ask",
          "when": "false"
        },
        {
          "command": "sift.comment.askThread",
          "when": "false"
        },
        {
          "command": "sift.comment.cancelAsk",
          "when": "false"
        },
        {
          "command": "sift.diffRoundOn",
          "when": "false"
        },
        {
          "command": "sift.diffCumulativeOn",
          "when": "false"
        },
        {
          "command": "sift.comment.copy",
          "when": "false"
        },
        {
          "command": "sift.revealFile",
          "when": "sift.active"
        },
        {
          "command": "sift.ignoreFile",
          "when": "sift.active"
        },
        {
          "command": "sift.excludeFile",
          "when": "sift.active"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "sift.comment.ask",
          "group": "inline@1",
          "when": "commentController == sift"
        },
        {
          "command": "sift.comment.create",
          "group": "inline@2",
          "when": "commentController == sift && commentThreadIsEmpty"
        },
        {
          "command": "sift.comment.reply",
          "group": "inline@2",
          "when": "commentController == sift && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "sift.comment.askThread",
          "group": "inline@0",
          "when": "commentController == sift && commentThread == comment-open"
        },
        {
          "command": "sift.comment.cancelAsk",
          "group": "inline@0",
          "when": "commentController == sift && commentThread == comment-sent"
        },
        {
          "command": "sift.comment.resolve",
          "group": "inline@1",
          "when": "commentController == sift && commentThread =~ /-(open|answered)$/"
        },
        {
          "command": "sift.comment.reopen",
          "group": "inline@1",
          "when": "commentController == sift && commentThread =~ /-resolved$/"
        },
        {
          "command": "sift.comment.delete",
          "group": "inline@2",
          "when": "commentController == sift && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "sift.comment.copy",
          "group": "inline@0",
          "when": "commentController == sift && comment =~ /^(own|ai)$/"
        },
        {
          "command": "sift.comment.edit",
          "group": "inline@1",
          "when": "commentController == sift && comment == own"
        },
        {
          "command": "sift.comment.deleteMessage",
          "group": "inline@2",
          "when": "commentController == sift && comment == own"
        }
      ],
      "comments/comment/context": [
        {
          "command": "sift.comment.saveEdit",
          "group": "inline@1",
          "when": "commentController == sift"
        },
        {
          "command": "sift.comment.cancelEdit",
          "group": "inline@2",
          "when": "commentController == sift"
        }
      ],
      "sift.compareWith": [
        {
          "command": "sift.diffRound",
          "when": "sift.diffMode != round",
          "group": "1@1"
        },
        {
          "command": "sift.diffRoundOn",
          "when": "sift.diffMode == round",
          "group": "1@1"
        },
        {
          "command": "sift.diffCumulative",
          "when": "sift.diffMode != cumulative",
          "group": "1@2"
        },
        {
          "command": "sift.diffCumulativeOn",
          "when": "sift.diffMode == cumulative",
          "group": "1@2"
        },
        {
          "command": "sift.compareVersions",
          "group": "2@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "sift.tab",
          "when": "sift.active && resourceScheme =~ /^(file|sift)$/",
          "group": "sift@1"
        }
      ],
      "sift.tab": [
        {
          "command": "sift.revealFile",
          "group": "0@1"
        },
        {
          "command": "sift.markDone",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles",
          "group": "1@1"
        },
        {
          "command": "sift.unapproveFile",
          "when": "resourcePath in sift.doneFiles",
          "group": "1@1"
        },
        {
          "command": "sift.markInProgress",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1@2"
        },
        {
          "command": "sift.markTodo",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles",
          "group": "1@3"
        },
        {
          "command": "sift.ignoreFile",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles || resourcePath in sift.unassignedFiles",
          "group": "1_ignore@1"
        },
        {
          "command": "sift.excludeFile",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles || resourcePath in sift.unassignedFiles",
          "group": "1_ignore@2"
        },
        {
          "command": "sift.moveToCommit",
          "when": "resourcePath in sift.todoFiles || resourcePath in sift.inProgressFiles || resourcePath in sift.doneFiles || resourcePath in sift.unassignedFiles",
          "group": "2@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sift.markDone",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "sift.active"
      },
      {
        "command": "sift.markTodo",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "sift.active"
      },
      {
        "command": "sift.nextTodo",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "sift.active"
      },
      {
        "command": "sift.toggleDiffMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "sift.active"
      },
      {
        "command": "sift.askAi",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "sift.active && !commentEditorFocused"
      },
      {
        "command": "editor.action.submitComment",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused"
      },
      {
        "command": "workbench.view.extension.sift",
        "key": "ctrl+alt+s",
        "mac": "ctrl+shift+s"
      }
    ],
    "configuration": {
      "title": "Sift",
      "properties": {
        "sift.stateLocation": {
          "type": "string",
          "enum": [
            "repo",
            "workspaceStorage"
          ],
          "enumDescriptions": [
            "<repo>/.sift/state.json (excluded from git via .git/info/exclude)",
            "VS Code workspace storage (outside the repo)"
          ],
          "default": "repo",
          "description": "Where the review state file is stored."
        },
        "sift.snapshotMaxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "New (untracked) files larger than this are left out of snapshots."
        },
        "sift.ai.provider": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "gemini",
            "vscode",
            "custom"
          ],
          "enumItemLabels": [
            "Claude Code",
            "Codex",
            "Gemini CLI",
            "VS Code model",
            "Custom command"
          ],
          "enumDescriptions": [
            "Claude Code's command line tool: the one bundled with the Claude Code extension, else `claude` from your shell.",
            "OpenAI's Codex command line tool (`codex`).",
            "Google's Gemini command line tool (`gemini`).",
            "A model available in VS Code, e.g. from GitHub Copilot (GPT, Claude, Gemini, Grok…) or another extension.",
            "Any command that reads the prompt on stdin and prints the answer: set it in Command."
          ],
          "default": "claude",
          "markdownDescription": "Which AI Sift asks. The easiest way to set it is **Sift: Choose AI…**, or click the AI's name in the status bar."
        },
        "sift.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model to use, in the provider's own terms: e.g. `opus` for Claude Code, `flash` for Gemini CLI, a model id for VS Code models. Empty: the provider's default."
        },
        "sift.ai.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "For **Custom command**: the command, run in your login shell at the repository root, e.g. `llm -m gpt-4o`. For the command line AIs: the path to the tool, when Sift can't find it by itself."
        },
        "sift.ai.additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders outside the repository the AI may read, e.g. `~/code` for sibling worktrees. Used by Claude Code and Gemini CLI."
        },
        "sift.ai.extraArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra options for the command line AI, added to the ones Sift passes. E.g. `--allowedTools=WebFetch` lets Claude Code fetch web pages; `--profile=work` picks a Codex profile."
        },
        "sift.ai.claudeCodeModel": {
          "type": "string",
          "default": "",
          "description": "Replaced by the generic sift.ai settings; moved automatically.",
          "deprecationMessage": "Replaced by sift.ai.model, sift.ai.command, sift.ai.additionalDirectories and sift.ai.extraArguments. Sift moves it there on startup."
        },
        "sift.ai.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Replaced by the generic sift.ai settings; moved automatically.",
          "deprecationMessage": "Replaced by sift.ai.model, sift.ai.command, sift.ai.additionalDirectories and sift.ai.extraArguments. Sift moves it there on startup."
        },
        "sift.ai.claudeCodeAdditionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Replaced by the generic sift.ai settings; moved automatically.",
          "deprecationMessage": "Replaced by sift.ai.model, sift.ai.command, sift.ai.additionalDirectories and sift.ai.extraArguments. Sift moves it there on startup."
        },
        "sift.ai.claudeCodeAllowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Replaced by the generic sift.ai settings; moved automatically.",
          "deprecationMessage": "Replaced by sift.ai.model, sift.ai.command, sift.ai.additionalDirectories and sift.ai.extraArguments. Sift moves it there on startup."
        },
        "sift.ai.languageModel": {
          "type": "string",
          "default": "",
          "description": "Replaced by the generic sift.ai settings; moved automatically.",
          "deprecationMessage": "Replaced by sift.ai.model, sift.ai.command, sift.ai.additionalDirectories and sift.ai.extraArguments. Sift moves it there on startup."
        }
      }
    },
    "submenus": [
      {
        "id": "sift.compareWith",
        "label": "Compare with",
        "icon": "$(versions)"
      },
      {
        "id": "sift.tab",
        "label": "Sift"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build -- --production && vsce package --no-dependencies"
  },
